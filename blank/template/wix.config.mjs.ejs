// @ts-check
import { defineWixConfig } from '@wix/cli/config';

export default defineWixConfig({
  config: {
    appId: '<%= devCenter.appId %>',
    projectId: '<%= packageName %>',
<% if (devCenter.namespace) { -%>
    namespace: '<%= devCenter.namespace %>',
<% } -%>
<% if (devCenter.codeIdentifier) { -%>
    codeIdentifier: '<%= devCenter.codeIdentifier %>',
<% } -%>
    projectType: 'App',
  },
});
